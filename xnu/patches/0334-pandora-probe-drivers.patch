+	const char     *name;
+	unsigned	ctrl;		/* index into ts_ctrl[] */
+	unsigned	first;		/* first sensor index, inclusive */
+	unsigned	last;		/* last sensor index, inclusive  */
+	int		warn;		/* deci-C, DT trip we warn at     */
+	int		trap;		/* deci-C, DT trip we trap at     */
+};
