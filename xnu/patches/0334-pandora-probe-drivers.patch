+#define TS_VALID        (1u << 21)
+#define TS_TEMP_MASK    0xffffu
+#define TS_TEMP_MIN     (-400)          /* -40.0 C, deci-Celsius */
+#define TS_TEMP_MAX     1500            /* 150.0 C                */
+
