+/*
+ * /dev/redwood-touch: a queue of touch samples (see sys/redwood_input.h).
+ */
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread_call.h>
+#include <libkern/libkern.h>
+#include <miscfs/devfs/devfs.h>
+#include <sys/conf.h>
