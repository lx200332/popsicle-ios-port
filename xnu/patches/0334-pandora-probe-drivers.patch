+	{ "cpu-1",  3u,  0u,  3u,  950, 1140 },   /* tsens3,  4 sensors */
+	{ "cpullc", 0u,  0u,  1u,  950, 1140 },   /* tsens0, first 2 of 5 */
+	{ "cpullc1", 2u, 0u,  1u,  950, 1140 },   /* tsens2, first 2 of 7 */
+	{ "gpu",    5u,  0u, 10u,  950, 1140 },   /* tsens5 gpuss-0..10  */
