/dts-v1/;

/ {
	/ {
		model = "Qualcomm Technologies, Inc. Popsicle based on SM8850";
		compatible = "qcom,canoe-mtp", "qcom,canoe", "qcom,canoep-mtp", "qcom,canoep", "qcom,mtp";
		qcom,msm-id = <0x2d3 0x30000 0x2d2 0x30000 0x2e7 0x20000 0x2e7 0x10000>;
		qcom,board-id = <0x8 0x0>;
		xiaomi,miboard-id = <0x1 0x0>;
		fragment@0 {
			target = <0xffffffff>;
			__overlay__ {
				pmk8850@0 {
					compatible = "qcom,spmi-pmic";
					reg = <0x0 0x0>;
					#address-cells = <0x1>;
					#size-cells = <0x0>;
					phandle = <0x6a>;
					pmic-ecid@100 {
						compatible = "qcom,pmic-ecid";
						reg = <0x100>;
						qcom,pmic-name = "pmk8850";
					};
					sdam@7000 {
						compatible = "qcom,spmi-sdam";
						reg = "", "", "p";
						#address-cells = <0x1>;
						#size-cells = <0x1>;
						phandle = <0x6b>;
						ocp-log@76 {
							reg = <0x76 0x6>;
							phandle = <0x18>;
						};
					};
					sdam@7100 {
						compatible = "qcom,spmi-sdam";
						reg = "", "", "q";
						#address-cells = <0x1>;
						#size-cells = <0x1>;
						phandle = <0x6c>;
						restart@48 {
							reg = <0x48 0x1>;
							bits = <0x1 0x7>;
							phandle = <0x15>;
						};
						bob1-off-mode-enable@50 {
							reg = <0x50 0x1>;
							phandle = <0x4f>;
						};
						xo_calib-data@59 {
							reg = <0x59 0x1>;
							phandle = <0x6d>;
						};
						alarm-log@76 {
							reg = <0x76 0x6>;
							phandle = <0x19>;
						};
						fmd-set@9a {
							reg = <0x9a 0x1>;
							phandle = <0x6e>;
						};
						fmd_cont_after_pon@9c {
							reg = <0x9c 0x1>;
							phandle = <0x6f>;
						};
						fmd-chg-pon@9f {
							reg = <0x9f 0x1>;
							phandle = <0x70>;
						};
						fmd-cnt2-stop@a2 {
							reg = <0xa2 0x1>;
							phandle = <0x71>;
						};
					};
					sdam@7400 {
						compatible = "qcom,spmi-sdam";
						reg = "", "", "t";
						phandle = <0x16>;
					};
					sdam@7500 {
						compatible = "qcom,spmi-sdam";
						reg = "", "", "u";
						phandle = <0x17>;
					};
					sdam@8400 {
						compatible = "qcom,spmi-sdam";
						reg = <0x8400>;
						phandle = <0xc>;
					};
					sdam@8500 {
						compatible = "qcom,spmi-sdam";
						reg = <0x8500>;
						phandle = <0xd>;
					};
					sdam@9a00 {
						compatible = "qcom,spmi-sdam";
						reg = <0x9a00>;
						#address-cells = <0x1>;
						#size-cells = <0x1>;
						phandle = <0x72>;
						sqm-timer@b8 {
							reg = <0xb8 0x2>;
							phandle = <0x11>;
						};
					};
					sdam@9d00 {
						compatible = "qcom,spmi-sdam";
						reg = <0x9d00>;
						phandle = <0x14>;
					};
					sdam@aa00 {
						compatible = "qcom,spmi-sdam";
						reg = <0xaa00>;
						phandle = <0xe>;
					};
					sdam@ab00 {
						compatible = "qcom,spmi-sdam";
						reg = <0xab00>;
						phandle = <0xf>;
					};
					sdam@ac00 {
						compatible = "qcom,spmi-sdam";
						reg = <0xac00>;
						phandle = <0x10>;
					};
					pon_hlos@1300 {
						compatible = "qcom,pmk8350-pon";
						reg = <0x1300 0x800>;
						reg-names = "hlos", "pbs";
						pwrkey {
							compatible = "qcom,pmk8350-pwrkey";
							interrupts = <0x0 0x13 0x7 0x3>;
							linux,code = <0x74>;
						};
						resin {
							compatible = "qcom,pmk8350-resin";
							interrupts = <0x0 0x13 0x6 0x3>;
							linux,code = <0x72>;
						};
						pwrkey-bark {
							compatible = "qcom,pmk8350-pwrkey-bark";
							interrupts = <0x0 0x13 0x0 0x3>;
							linux,code = <0x74>;
						};
						pwrkey-resin-bark {
							compatible = "qcom,pmk8350-pwrkey-resin-bark";
							interrupts = <0x0 0x13 0x2 0x3>;
							linux,code = <0x74>;
						};
					};
					sdam@a000 {
						compatible = "qcom,spmi-sdam";
						reg = <0xa000>;
						phandle = <0x5>;
					};
					sdam@a100 {
						compatible = "qcom,spmi-sdam";
						reg = <0xa100>;
						phandle = <0x6>;
					};
					sdam@a200 {
						compatible = "qcom,spmi-sdam";
						reg = <0xa200>;
						phandle = <0x7>;
					};
					sdam@b600 {
						compatible = "qcom,spmi-sdam";
						reg = <0xb600>;
						phandle = <0x73>;
						usb-mode@50 {
							reg = <0x50 0x1>;
							phandle = <0x34>;
						};
					};
					sdam@b700 {
						compatible = "qcom,spmi-sdam";
						reg = <0xb700>;
						phandle = <0x8>;
					};
					pinctrl@b800 {
						compatible = "qcom,pmk8850-gpio";
						reg = <0xb800>;
						gpio-controller;
						#gpio-cells = <0x2>;
						interrupt-controller;
						#interrupt-cells = <0x2>;
						pinctrl-0 = <0x1>;
						pinctrl-names = "default";
						phandle = <0x74>;
						alt-sleep-clk-default-state {
							pins = "gpio3";
							function = "func1";
							input-disable;
							output-enable;
							power-source = <0x0>;
							phandle = <0x1>;
						};
						lcd-bl-pwm-default-state {
							pins = "gpio5";
							function = "func3";
							input-disable;
							output-enable;
							power-source = <0x0>;
							phandle = <0x75>;
						};
						xoagg-therm-default-state {
							pins = "gpio7";
							function = "normal";
							bias-high-impedance;
							phandle = <0x2>;
						};
					};
					rtc@6100 {
						compatible = "qcom,pmk8350-rtc";
						reg = "", "", "a", "", "", "b";
						reg-names = "rtc", "alarm";
						interrupts = <0x0 0x62 0x1 0x1>;
						phandle = <0x76>;
					};
					pmk8850-pwm {
						compatible = "qcom,pmk8850-pwm", "qcom,pmk8550-pwm";
						#address-cells = <0x1>;
						#size-cells = <0x0>;
						#pwm-cells = <0x2>;
					};
					vadc@9000 {
						compatible = "qcom,spmi-adc5-gen4";
						reg = <0x9000 0x9100>;
						#address-cells = <0x1>;
						#size-cells = <0x0>;
						interrupts = <0x0 0x90 0x1 0x1 0x0 0x91 0x1 0x1>;
						interrupt-names = "adc-sdam0", "adc-sdam1";
						#thermal-sensor-cells = <0x1>;
						#io-channel-cells = <0x1>;
						io-channel-ranges;
						pinctrl-0 = <0x2 0x3 0x4>;
						pinctrl-names = "default";
						phandle = <0x9>;
						pmk8850_offset_ref {
							reg = <0x0>;
							label = "pmk8850_offset_ref";
						};
						pmk8850_vref_1p25 {
							reg = <0x1>;
							label = "pmk8850_vref_1p25";
						};
						pmk8850_die_temp {
							reg = <0x3>;
							label = "pmk8850_die_temp";
						};
						pmk8850_xoagg_therm {
							reg = <0x4b>;
							label = "pmk8850_xoagg_therm";
							qcom,ratiometric;
							qcom,hw-settle-time = <0xc8>;
							qcom,adc-tm-type = <0x1>;
							status = "ok";
							phandle = <0x77>;
						};
						pmh0101_offset_ref {
							reg = <0x100>;
							label = "pmh0101_offset_ref";
						};
						pmh0101_vref_1p25 {
							reg = <0x101>;
							label = "pmh0101_vref_1p25";
						};
						pmh0101_die_temp {
							reg = <0x103>;
							label = "pmh0101_die_temp";
						};
						pmh0101_vph_pwr {
							reg = <0x18e>;
							label = "pmh0101_vph_pwr";
						};
						pmh0101_qtm_therm {
							reg = <0x14b>;
							label = "pmh0101_qtm_therm";
							qcom,ratiometric;
							qcom,hw-settle-time = <0xc8>;
							qcom,adc-tm-type = <0x1>;
							status = "ok";
							phandle = <0x78>;
						};
						pmh0101_pa_therm2 {
							reg = <0x149>;
							label = "pmh0101_pa_therm_2";
							qcom,ratiometric;
							qcom,hw-settle-time = <0xc8>;
							qcom,adc-tm-type = <0x1>;
						};
						pmh0110_d_die_temp {
							reg = <0x303>;
							label = "pmh0110_d_die_temp";
						};
						pmh0110_d_vph_pwr {
							reg = <0x38e>;
							label = "pmh0110_d_vph_pwr";
						};
						pmh0110_f_die_temp {
							reg = <0x503>;
							label = "pmh0110_f_die_temp";
						};
						pmh0110_f_vph_pwr {
							reg = <0x58e>;
							label = "pmh0110_f_vph_pwr";
						};
						pmh0110_g_die_temp {
							reg = <0x603>;
							label = "pmh0110_g_die_temp";
						};
						pmh0110_g_vph_pwr {
							reg = <0x68e>;
							label = "pmh0110_g_vph_pwr";
						};
						pmh0110_i_die_temp {
							reg = <0x803>;
							label = "pmh0110_i_die_temp";
						};
						pmh0110_i_vph_pwr {
							reg = <0x88e>;
							label = "pmh0110_i_vph_pwr";
						};
						pmih010x_offset_ref {
							reg = "", "", "'";
							label = "pmih010x_offset_ref";
						};
						pmih010x_vref_1p25 {
							reg = <0x2701>;
							label = "pmih010x_vref_1p25";
						};
						pmih010x_die_temp {
							reg = <0x2703>;
							label = "pmih010x_die_temp";
						};
						pmih010x_vph_pwr {
							reg = <0x278e>;
							label = "pmih010x_vph_pwr";
						};
						pmih010x_vbat_sns_qbg {
							reg = <0x278f>;
							label = "pmih010x_vbat_sns_qbg";
						};
						pmih010x_iin {
							reg = <0x2717>;
							label = "pmih010x_iin";
						};
						pmih010x_ichg_fb {
							reg = <0x27a1>;
							label = "pmih010x_ichg_fb";
						};
						pmih010x_chg_temp {
							reg = <0x2710>;
							label = "pmih010x_chg_temp";
						};
						pmih010x_lite_die_temp {
							reg = <0x2718>;
							label = "pmih010x_lite_die_temp";
						};
						pmih010x_display_therm {
							reg = <0x275e>;
							label = "pmih010x_display_therm";
							qcom,ratiometric;
							qcom,hw-settle-time = <0xc8>;
							qcom,adc-tm-type = <0x1>;
							status = "ok";
							phandle = <0x79>;
						};
						pmih010x_charger_therm {
							reg = <0x274d>;
							label = "pmih010x_charger_therm";
							qcom,ratiometric;
							qcom,hw-settle-time = <0xc8>;
							qcom,adc-tm-type = <0x1>;
							status = "ok";
							phandle = <0x7a>;
						};
						pmh0101_wireless_therm {
							reg = <0x14c>;
							label = "pmh0101_wireless_therm";
							qcom,ratiometric;
							qcom,hw-settle-time = <0xc8>;
							qcom,adc-tm-type = <0x1>;
							phandle = <0x7b>;
						};
						pmh0101_cpu_therm {
							reg = <0x14d>;
							label = "pmh0101_cpu_therm";
							qcom,ratiometric;
							qcom,hw-settle-time = <0xc8>;
							qcom,adc-tm-type = <0x1>;
						};
						pmk8850_xo_therm {
							reg = <0x44>;
							label = "pmk8850_xo_therm";
							qcom,ratiometric;
							qcom,hw-settle-time = <0xc8>;
							qcom,adc-tm-type = <0x1>;
						};
						pmh0101_wifi_therm {
							reg = <0x146>;
							label = "pmh0101_wifi_therm";
							qcom,ratiometric;
							qcom,hw-settle-time = <0xc8>;
							qcom,adc-tm-type = <0x1>;
						};
						pmh0101_pa_therm1 {
							reg = <0x147>;
							label = "pmh0101_pa_therm_1";
							qcom,ratiometric;
							qcom,hw-settle-time = <0xc8>;
							qcom,adc-tm-type = <0x1>;
						};
						pmh0101_quiet_therm {
							reg = <0x144>;
							label = "pmh0101_quiet_therm";
							qcom,ratiometric;
							qcom,hw-settle-time = <0xc8>;
							qcom,adc-tm-type = <0x1>;
						};
						pmh0101_flash_therm {
							reg = <0x145>;
							label = "pmh0101_flash_therm";
							qcom,ratiometric;
							qcom,hw-settle-time = <0xc8>;
							qcom,adc-tm-type = <0x1>;
						};
						pmih010x_batt_therm {
							reg = <0x2744>;
							label = "pmih010x_batt_therm";
							qcom,ratiometric;
							qcom,hw-settle-time = <0xc8>;
							qcom,adc-tm-type = <0x1>;
						};
						pmih010x_conn_therm {
							reg = <0x2747>;
							label = "pmih010x_conn_therm_1";
							qcom,ratiometric;
							qcom,hw-settle-time = <0xc8>;
							qcom,adc-tm-type = <0x1>;
						};
					};
					qcom,power-telemetry-device {
						compatible = "qcom,power-telemetry";
						status = "okay";
						interrupts = <0x0 0xa2 0x1 0x1 0x0 0xa1 0x1 0x1>;
						nvmem = <0x5 0x6 0x7>;
						nvmem-names = "qpt-config-sdam", "qpt-frac-sdam", "qpt-data-sdam";
						#powerzone-cells = <0x1>;
						power-domains = <0xffffffff>;
						phandle = <0x1a>;
					};
					qcom,voltage-adj-device {
						compatible = "qcom,vadj";
						phandle = <0x7c>;
					};
					btl {
						compatible = "qcom,btl";
						nvmem = <0x8>;
						nvmem-names = "btl-sdam";
					};
					qcom,power-telemetry-data-share-device {
						compatible = "qcom,power-telemetry-data-share";
					};
				};
				pmh0101@1 {
					compatible = "qcom,spmi-pmic";
					reg = <0x1 0x0>;
					#address-cells = <0x1>;
					#size-cells = <0x0>;
					pmic-ecid@100 {
						compatible = "qcom,pmic-ecid";
						reg = <0x100>;
						qcom,pmic-name = "pmh0101";
					};
					pmh0101-temp-alarm@a00 {
						compatible = "qcom,spmi-temp-alarm";
						reg = "", "", "\n";
						interrupts = <0x1 0xa 0x0 0x3>;
						#thermal-sensor-cells = <0x0>;
						io-channels = <0x9 0x103>;
						io-channel-names = "thermal";
						phandle = <0x24>;
					};
					pinctrl@8800 {
						compatible = "qcom,pmh0101-gpio";
						reg = <0x8800>;
						gpio-controller;
						#gpio-cells = <0x2>;
						interrupt-controller;
						#interrupt-cells = <0x2>;
						pinctrl-0 = <0xa 0xb>;
						pinctrl-names = "default";
						phandle = <0x49>;
						qtm-therm-default-state {
							pins = "gpio2";
							function = "normal";
							bias-high-impedance;
							phandle = <0x4>;
						};
						pa-therm2-default-state {
							pins = "gpio3";
							function = "normal";
							bias-high-impedance;
							phandle = <0x3>;
						};
						cam-sensor-1p8-rst0-active-state {
							pins = "gpio4";
							function = "normal";
							qcom,drive-strength = <0x2>;
							input-disable;
							output-enable;
							output-high;
							power-source = <0x0>;
							phandle = <0x7d>;
						};
						cam-sensor-1p8-rst0-suspend-state {
							pins = "gpio4";
							function = "normal";
							qcom,drive-strength = <0x2>;
							input-disable;
							output-enable;
							output-low;
							phandle = <0x7e>;
						};
						pmh0101-bidir-lvl-shifter1-state {
							pins = "gpio11", "gpio12";
							function = "normal";
							bias-high-impedance;
							phandle = <0x7f>;
						};
						pmh0101-bidir-lvl-shifter2-state {
							pins = "gpio13", "gpio14";
							function = "normal";
							bias-high-impedance;
							phandle = <0x80>;
						};
						pmh0101-bidir-lvl-shifter3-state {
							pins = "gpio15", "gpio16";
							function = "normal";
							bias-high-impedance;
							phandle = <0x81>;
						};
						pmh0101-bidir-lvl-shifter4-state {
							pins = "gpio17", "gpio18";
							function = "normal";
							bias-high-impedance;
							phandle = <0x82>;
						};
						wireless_therm-default-state {
							pins = "gpio9";
							function = "normal";
							bias-high-impedance;
							phandle = <0xa>;
						};
						cpu_therm-default-state {
							pins = "gpio12";
							function = "normal";
							bias-high-impedance;
							phandle = <0xb>;
						};
						slave_batt_det {
							slave_batt_det_default {
								pins = "gpio1";
								function = "gpio";
								input-enable;
								bias-pull-up;
								phandle = <0x48>;
							};
						};
					};
					led-controller {
						compatible = "qcom,pmh0101-pwm", "qcom,pm8350c-pwm";
						#address-cells = <0x1>;
						#size-cells = <0x0>;
						#pwm-cells = <0x2>;
						nvmem = <0xc 0xd>;
						nvmem-names = "lpg_chan_sdam", "lut_sdam";
						phandle = <0x83>;
						led@1 {
							reg = <0x1>;
							color = <0x1>;
							label = "red";
						};
						led@2 {
							reg = <0x2>;
							color = <0x2>;
							label = "green";
						};
						led@3 {
							reg = <0x3>;
							color = <0x3>;
							label = "blue";
						};
					};
					bcl@4700 {
						compatible = "qcom,pmh0101-bcl-v5";
						reg = <0x4700 0x100>;
						interrupts = <0x1 0x47 0x0 0x0 0x1 0x47 0x1 0x0 0x1 0x47 0x2 0x0>;
						interrupt-names = "bcl-lvl0", "bcl-lvl1", "bcl-lvl2";
						qcom,pmic7-threshold;
						#thermal-sensor-cells = <0x1>;
						phandle = <0x1f>;
					};
					led-controller@ee00 {
						compatible = "qcom,pmh0101-flash-led", "qcom,spmi-flash-led";
						reg = <0xee00>;
						phandle = <0x84>;
						led-0 {
							function = "flash";
							function-enumerator = <0x0>;
							color = <0x6>;
							led-sources = <0x1 0x4>;
							led-max-microamp = <0x7a120>;
							flash-max-microamp = <0x1e8480>;
							flash-max-timeout-us = <0x138800>;
							phandle = <0x85>;
						};
						led-1 {
							function = "flash";
							function-enumerator = <0x1>;
							color = <0x0>;
							led-sources = <0x2 0x3>;
							led-max-microamp = <0x7a120>;
							flash-max-microamp = <0x1e8480>;
							flash-max-timeout-us = <0x138800>;
							phandle = <0x86>;
						};
						led-2 {
							function = "flash";
							function-enumerator = <0x2>;
							color = <0x4>;
							led-sources = <0x1 0x2 0x3 0x4>;
							led-max-microamp = <0x7a120>;
							flash-max-microamp = <0x1e8480>;
							flash-max-timeout-us = <0x138800>;
							phandle = <0x87>;
						};
					};
				};
				pmh0110@3 {
					compatible = "qcom,spmi-pmic";
					reg = <0x3 0x0>;
					#address-cells = <0x1>;
					#size-cells = <0x0>;
					phandle = <0x88>;
					pmic-ecid@100 {
