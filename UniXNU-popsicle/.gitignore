# Build outputs and caches (re-derivable; nothing important lives here)
/build/
/Build/
/Conf/
/out/
/.cache/
/refer/
/.local*/
/Mu_Basecore/

# Local development files
*.log
*.terminal
*.swp
*.swo
*~
.DS_Store
.vscode/
.idea/
__pycache__/
*.pyc
*.dSYM/

# Inputs, images and products that never belong in Git
*.ipsw
*.dmg
*.im4p
*.img
*.dbr
*.macho
*.o
*.a
*.dylib
*.efi
*.dtb
*.bc
*.spv
*.metallib
*.bin
*.mbn
*.fw
*.pem
*.key
.env
local.toml

# The merged device tree is an input, not a product: the firmware embeds it and every boot image
# carries it, so losing it makes the board unbuildable. It is exempted from the rule above because
# a silently-ignored 1.7 MB blob is indistinguishable from a repository that never had one.
!firmware/Platforms/*/*Pkg/FdtBlob/*.dtb
